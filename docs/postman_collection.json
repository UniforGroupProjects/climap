        {
          "name": "Buscar Clima - nome invalido",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status 400\", function () {\r",
                  "    pm.response.to.have.status(400);\r",
                  "});\r",
                  "\r",
                  "const jsonData = pm.response.json();\r",
                  "\r",
                  "pm.test(\"Erro é true\", function () {\r",
                  "    pm.expect(jsonData.erro).to.eql(true);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Código correto\", function () {\r",
                  "    pm.expect(jsonData.codigo)\r",
                  "        .to.eql(\"NOME_INVALIDO\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Mensagem correta\", function () {\r",
                  "    pm.expect(jsonData.mensagem)\r",
                  "        .to.eql(\r",
                  "            \"O nome da cidade deve conter pelo menos 2 caracteres\"\r",
                  "        );\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Nome informado retornado\", function () {\r",
                  "    pm.expect(jsonData.nome_informado)\r",
                  "        .to.eql(\"X\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
