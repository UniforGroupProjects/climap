      "name": "Clima",
      "item": [
        {
          "name": "Buscar Clima",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code é 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Resposta possui nome\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "\r",
                  "    pm.expect(json).to.have.property(\"nome\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Resposta possui estado\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "\r",
                  "    pm.expect(json).to.have.property(\"estado\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Resposta possui clima\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "\r",
                  "    pm.expect(json).to.have.property(\"clima\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Resposta possui data da consulta\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "\r",
                  "    pm.expect(json).to.have.property(\"consultado_em\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Clima possui os campos esperados\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "\r",
                  "    pm.expect(json.clima).to.have.property(\"temperatura_min\");\r",
                  "    pm.expect(json.clima).to.have.property(\"temperatura_max\");\r",
                  "    pm.expect(json.clima).to.have.property(\"condicao\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Temperaturas são números\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "\r",
                  "    pm.expect(json.clima.temperatura_min).to.be.a(\"number\");\r",
                  "    pm.expect(json.clima.temperatura_max).to.be.a(\"number\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
